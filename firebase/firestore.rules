rules_version = '2';

// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣으세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 레고 상품 정보
    match /legos/{legoId} {
      allow read: if true; // 누구나 조회 가능

      // ⚠️ 데모 단계: 관리자 대량 등록을 위해 생성/수정을 열어둡니다.
      // 운영 전환 시 Firebase Auth로 관리자 로그인을 만들고
      // 아래를 `if request.auth != null` 등으로 교체하세요.
      allow create, update: if true;
      allow delete: if false;
    }

    // 완성작 방명록
    match /guestbookEntries/{entryId} {
      // ⚠️ 데모 단계: 숨김 여부와 무관하게 읽기를 허용하고,
      // 실제 숨김/공개 필터링은 앱 코드(GuestbookFeed, 모더레이션 화면)에서 처리합니다.
      allow read: if true;

      // 아이들이 완성 인증을 새로 등록
      allow create: if true;

      // 관리자가 숨김 처리(is Hidden 토글)하는 용도 (데모 단계 anon 허용)
      allow update: if true;
      allow delete: if false;
    }
  }
}
